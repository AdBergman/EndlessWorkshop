{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "framer-motion": "^12.43.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-csv": "^2.2.2",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "start": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "lint": "eslint .",
    "test": "vitest --config vitest.config.ts",
    "diagnostics:codex-content": "node --experimental-strip-types scripts/codex-content-quality-diagnostic.ts",
    "diagnostics:codex-player-content": "node --experimental-strip-types scripts/codex-player-content-quality-diagnostic.ts",
    "diagnostics:codex-preview-surfaces": "node --experimental-strip-types scripts/codex-preview-surface-audit.ts",
    "diagnostics:codex-relationship-gaps": "node --experimental-strip-types scripts/codex-relationship-value-gap-audit.ts",
    "diagnostics:codex-references": "node --experimental-strip-types scripts/codex-reference-diagnostics.ts",
    "diagnostics:quests": "vite-node --config vite.config.ts scripts/quest-explorer-diagnostic.ts",
    "diagnostics:quests:lore-chronology": "vite-node --config vite.config.ts scripts/quest-lore-chronology-diagnostic.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-csv": "^1.1.10",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
